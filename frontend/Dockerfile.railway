FROM node:22-alpine AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Задаётся в Railway: Variables → VITE_API_URL = https://<backend>.up.railway.app
ARG VITE_API_URL=https://example.up.railway.app
ENV VITE_API_URL=$VITE_API_URL

RUN npm run build

FROM node:22-alpine

WORKDIR /app

RUN npm install -g serve@14.2.4

COPY --from=build /app/dist ./dist

ENV NODE_ENV=production

# Railway подставляет PORT
CMD ["sh", "-c", "serve -s dist -l ${PORT:-3000}"]
